{
  "scenario": "drop",
  "description": "Spin effect test - Magnus effect from ball spin causes curved trajectory",
  "ball": {
    "mass": 0.45,
    "radius": 0.11,
    "spin_rps": 12.0
  },
  "position": {
    "x0": 0.0,
    "y0": 0.0,
    "z0": 15.0
  },
  "wind": {
    "humidity_pct": 45.0,
    "ref_speed": 0.0,
    "ref_height": 10.0,
    "shear_alpha": 0.0,
    "direction_deg": 0.0,
    "gust_tau": 1.0,
    "gust_sigma": 0.0
  },
  "simulation": {
    "g": 9.81,
    "dt": 0.001,
    "t_max": 6.0,
    "seed": 321,
    "adaptive_timestep": false,
    "buoyancy": true,
    "use_virtual_mass": true,
    "use_multi_regime_cd": true,
    "use_hertzian_contact": true,
    "stop_speed_threshold": 0.05,
    "stop_angular_threshold": 0.5,
    "stop_hold_time": 0.5,
    "c_spin_decay": 0.08,
    "c_spin_aero": 0.03
  },
  "output": {
    "run_name": "spin_effect_test",
    "output_dir": "outputs/spin_effect",
    "csv_file": "spin_effect_data.csv",
    "plot_file": "spin_effect_plot.png",
    "html_file": "spin_effect_report.html"
  },
  "test_expectations": {
    "description": "Ball should curve due to Magnus effect from spin",
    "spin_direction": "z-axis (topspin/backspin)",
    "expected_curve": "Lateral deflection due to Magnus force",
    "expected_behavior": "Curved trajectory perpendicular to spin axis",
    "magnus_effect": "Visible lateral movement even with no wind"
  }
}